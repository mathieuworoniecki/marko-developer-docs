{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "name": "MARKO Developers",
  "colors": {
    "primary": "#087E8B",
    "light": "#76E7F4",
    "dark": "#087E8B"
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "favicon": "/favicon.svg",
  "appearance": {
    "default": "light"
  },
  "search": {
    "prompt": "Rechercher…"
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Guides",
        "groups": [
          {
            "group": "Démarrer",
            "pages": ["index", "quickstart", "authentication"]
          },
          {
            "group": "Intégrer",
            "pages": ["environments", "errors-and-retries"]
          }
        ]
      },
      {
        "tab": "Référence API",
        "openapi": "https://partner-api.marko.fr/v1/openapi.json"
      }
    ]
  },
  "api": {
    "playground": {
      "display": "none"
    }
  },
  "contextual": {
    "options": ["copy", "view", "chatgpt", "claude"]
  }
}
