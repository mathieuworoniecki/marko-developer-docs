{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "name": "MARKO Developers",
  "colors": {
    "primary": "#087E8B",
    "light": "#76E7F4",
    "dark": "#087E8B"
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "favicon": "/favicon.svg",
  "appearance": {
    "default": "light"
  },
  "search": {
    "prompt": "Rechercher…"
  },
  "navigation": {
    "groups": [
      {
        "group": "Démarrer",
        "pages": [
          "index",
          "quickstart",
          "authentication",
          "concepts",
          "resources"
        ]
      },
      {
        "group": "Tutoriels",
        "pages": [
          "tutorials/crm-sync",
          "tutorials/batch-import",
          "tutorials/document-extraction",
          "code-examples"
        ]
      },
      {
        "group": "Intégrer",
        "pages": [
          "environments",
          "scopes-and-delegation",
          "pagination-and-data",
          "writes-and-idempotency",
          "errors-and-retries",
          "imports-and-notes",
          "documents-guide",
          "taxonomies-guide",
          "workflows-guide",
          "privacy-guide",
          "ai-and-tools",
          "changelog"
        ]
      },
      {
        "group": "Référence API",
        "openapi": "openapi.json"
      }
    ]
  },
  "api": {
    "playground": {
      "display": "none"
    },
    "examples": {
      "languages": [
        "curl",
        "python",
        "node",
        "typescript",
        "php"
      ]
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude"
    ]
  }
}
